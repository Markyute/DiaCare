# DiaCare API — Vercel environment variables
#
# Set these in the Vercel dashboard (Project -> Settings -> Environment
# Variables), NOT in a committed file. This example exists only to name
# them. Anything here is a credential.
#
# From the Firebase service-account JSON
# (Project settings -> Service accounts -> Generate new private key):
FIREBASE_PROJECT_ID=diacare-fe2d1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@diacare-fe2d1.iam.gserviceaccount.com
# Paste the whole PEM including the BEGIN/END lines. Vercel stores it on
# one line with literal \n sequences; core.js converts them back.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Gmail account that sends the codes, and its 16-character app password
# (https://myaccount.google.com/apppasswords — needs 2-Step Verification).
GMAIL_USER=diacare.rhulibon@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
