rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A password sign-in alone is NOT enough to read data. The custom
    // claims below are only set by the verifyOtp Cloud Function after the
    // emailed code has been checked, so a user who stops at the password
    // step can still read nothing.
    function signedInAndVerified() {
      return request.auth != null
          && 'otpVerified' in request.auth.token
          && request.auth.token.otpVerified == true
          && sessionStillValid();
    }

    // Claims survive across sessions, so the session's end is enforced
    // here rather than trusted to the browser. verify-otp stamps otpExp,
    // which is 12 hours normally and 30 days when the user asked to stay
    // signed in - the length is a property of the session, not a
    // constant every reader has to agree on.
    //
    // A session verified before otpExp existed only carries otpAt; those
    // keep the original 12-hour window rather than being locked out
    // mid-shift by a deploy.
    // Every key is checked with `in` before it is read. Reading a key
    // that is absent from request.auth.token is an error, not a false —
    // and an error denies the whole request. Written without these
    // guards, this denied every read for anyone whose token predated
    // otpExp, which is exactly who the fallback existed to serve.
    function sessionStillValid() {
      return ('otpExp' in request.auth.token && request.auth.token.otpExp is number)
          ? request.time.toMillis() < request.auth.token.otpExp
          : ('otpAt' in request.auth.token
             && request.auth.token.otpAt is number
             && request.time.toMillis() - request.auth.token.otpAt < 43200000);
    }

    // A BHW signs in through /api/bhw-login, which mints a custom token
    // carrying this claim. There is no emailed code on that path: a BHW
    // has no clinic inbox, often no signal, and the app is offline-first
    // - a second factor needing a live inbox would make the app unusable
    // in the field. The trade is that a BHW reaches only their own
    // patients, checked on every rule below, while the dashboard reaches
    // every barangay and keeps its code.
    function isBhw() {
      return request.auth != null
          && 'bhwVerified' in request.auth.token
          && request.auth.token.bhwVerified == true;
    }

    function ownsPatient(patient) {
      return isBhw() && patient.assignedBhwId == request.auth.uid;
    }

    function isAdmin() {
      return signedInAndVerified()
          && 'role' in request.auth.token
          && request.auth.token.role == 'admin';
    }

    // Staff accounts. Everyone verified may read the roster (the personnel
    // page needs it); only admins may create, change, or disable accounts,
    // and only through the Cloud Functions, which use the Admin SDK.
    // The roster is an administrator's view. A nurse can read their own
    // profile - the top-nav chip needs their name and role - but not the
    // rest of the staff list, which is the personnel page's data.
    //
    // Hiding the nav link and bouncing the page are conveniences; this is
    // what stops a nurse from simply querying the collection.
    match /users/{uid} {
      // Field workers are readable by any verified staff member, not just
      // admins: Sync Monitoring lists them, and assigning a patient to a
      // worker means showing a nurse the names to choose from. Only the
      // BHW-role documents open up — the rest of the staff list stays an
      // administrator's view.
      allow read: if isAdmin()
                  || (signedInAndVerified() && request.auth.uid == uid)
                  || (isBhw() && request.auth.uid == uid)
                  || (signedInAndVerified() && resource.data.role == 'bhw');

      // Someone may edit their own display details from Settings. The
      // whitelist is the security boundary: role, status, and email are
      // not in it, so this cannot be used to self-promote or to
      // reactivate a deactivated account. Everything else about an
      // account still goes through the admin-only API.
      // A BHW updates the same fields from the app (their photo), so the
      // self-edit path accepts either identity. The whitelist is what
      // makes that safe: role, status and email are absent from it, so
      // neither a nurse nor a BHW can promote themselves or reactivate a
      // deactivated account by editing their own profile.
      allow update: if (signedInAndVerified() || isBhw())
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                    // fcmToken is here so the app can register the device
                    // for push. It identifies a handset, not a person, and
                    // a worker overwriting their own is harmless — the
                    // fields that decide access are still absent.
                         .hasOnly(['fullName', 'contact', 'initials', 'photo',
                                   'fcmToken', 'fcmTokenUpdatedAt', 'updatedAt']);

      allow create, delete: if false;
    }

    // One-time codes. Never readable or writable by a browser — the
    // functions reach these with the Admin SDK, which bypasses rules.
    // Without this the emailed code could simply be read out of Firestore.
    match /otp_codes/{uid} {
      allow read, write: if false;
    }

    // Send-rate counters, same reasoning as otp_codes.
    match /otp_throttle/{uid} {
      allow read, write: if false;
    }

    // Password-reset rate limits. Keyed by a hash of the address rather
    // than the address itself, so the collection is not a readable list
    // of who has asked to reset. Server-only either way.
    match /reset_throttle/{key} {
      allow read, write: if false;
    }

    // BHW password hashes and sign-in attempt counters. Never readable
    // by any client, including the BHW they belong to - a password hash
    // has no business being reachable from a device. /api/bhw-login
    // reaches these with the Admin SDK, which bypasses rules.
    match /bhw_credentials/{username} {
      allow read, write: if false;
    }

    match /bhw_login_attempts/{username} {
      allow read, write: if false;
    }

    // Clinical data.
    match /patients/{patientId} {
      // Every BHW reads the whole roster, not only their own patients.
      // The RHU asked for this: a worker covering for a colleague, or
      // meeting a patient from the next purok, needs the history that
      // already exists rather than starting a second record for the same
      // person.
      //
      // Worth being clear about the trade: this is the municipality's
      // full diabetes register on every BHW's phone. Writes stay narrow -
      // a worker still cannot approve, reassign, or file under another
      // name - but reads are now wide.
      allow read: if signedInAndVerified() || isBhw();

      allow create: if signedInAndVerified()
                    // A BHW registers patients for themselves. There is no
                    // approval queue any more, so a registration syncs in
                    // live; 'pending' is still accepted because handsets
                    // running the older build still write it.
                    || (isBhw()
                        && request.resource.data.assignedBhwId == request.auth.uid
                        && request.resource.data.status in ['pending', 'approved']);

      allow update: if signedInAndVerified()
                    // A BHW may correct their own patient's details and
                    // re-sync them, but cannot hand them to someone else,
                    // and cannot revive a patient the RHU marked inactive
                    // — a rejected row stays rejected rather than coming
                    // back on the next sync from the phone.
                    || (ownsPatient(resource.data)
                        && request.resource.data.assignedBhwId == resource.data.assignedBhwId
                        && resource.data.status != 'inactive'
                        && request.resource.data.status in ['pending', 'approved']);

      allow delete: if isAdmin();

      match /{sub=**} {
        allow read: if signedInAndVerified();
        allow write: if signedInAndVerified();
      }
    }

    // Visit readings. Written by this dashboard's encoding page and, once
    // the mobile sync lands, pushed by the BHW app. Kept as a top-level
    // collection rather than a subcollection so a sync can ask for
    // everything changed since a timestamp in one query.
    //
    // No delete: a reading is a clinical record. Correcting one means
    // writing a newer record, not erasing the history a risk score was
    // calculated from.
    match /health_records/{recordId} {
      // Read by the patient's assigned worker, not by whoever wrote the
      // record. A visit encoded at the RHU has no bhwId, so keying the
      // read on that hid the nurse's own visits from the BHW who follows
      // that patient - an incomplete history, and exactly the history
      // they need before knocking on the door.
      //
      // assignedBhwId is copied onto the record rather than looked up
      // through the patient, because a rule that reads another document
      // costs a lookup for every record in every list.
      // Readable by any BHW, matching the roster above: a shared patient
      // list whose visit history was still private would show a patient
      // with no readings, which is worse than not showing them.
      allow read: if signedInAndVerified() || isBhw();

      // A record names the worker who took it, and a BHW may only file
      // one under their own name - otherwise a visit could be attributed
      // to a colleague who never made it.
      allow create: if signedInAndVerified()
                    || (isBhw()
                        && request.resource.data.bhwId == request.auth.uid
                        && request.resource.data.assignedBhwId == request.auth.uid);

      // A worker may correct their own visit — a mistyped glucose was
      // otherwise fixable only by asking the RHU. They cannot re-file it
      // under another worker or move it to another patient, so a
      // correction stays a correction.
      allow update: if signedInAndVerified()
                    || (isBhw()
                        && resource.data.bhwId == request.auth.uid
                        && request.resource.data.bhwId == resource.data.bhwId
                        && request.resource.data.patientId == resource.data.patientId);

      // A reading is a clinical record. Correcting one means writing a
      // newer record, not erasing the history a risk score came from.
      allow delete: if false;
    }

    // On-device alerts the app raises for its own worker: a high reading,
    // a patient not seen in a while. They belong to one BHW, so they are
    // scoped by bhwId the same way patients are by assignedBhwId.
    //
    // These live in Firestore rather than on the phone so they survive a
    // reinstall or a replacement device - the alert about a patient
    // nobody has visited in a month is exactly the thing that should not
    // vanish with a broken handset.
    //
    // The dashboard does not read these. It computes its own alerts from
    // the readings themselves, which is the same information reached a
    // different way.
    match /notifications/{notifId} {
      allow read: if isBhw() && resource.data.bhwId == request.auth.uid;
      allow create: if isBhw() && request.resource.data.bhwId == request.auth.uid;
      // Marking read or resolved. The owner cannot be reassigned, so an
      // alert cannot be moved onto someone else's list.
      allow update: if isBhw()
                    && resource.data.bhwId == request.auth.uid
                    && request.resource.data.bhwId == resource.data.bhwId;
      allow delete: if false;
    }

    // The one alert store both halves share. A high reading raised on a
    // BHW's phone appears on the RHU dashboard, and an alert acknowledged
    // at the RHU stops nagging the worker who is standing in front of the
    // patient. Previously the app kept its own notifications collection
    // and the dashboard recomputed its own list from readings, so neither
    // ever saw the other's.
    //
    // Ids are deterministic (patientId__type), so the same condition
    // raised on two devices is one document rather than two alerts about
    // the same patient.
    match /alerts/{alertId} {
      allow read: if signedInAndVerified() || isBhw();
      allow create, update: if signedInAndVerified() || isBhw();
      // An alert is a record that something was flagged. Closing one sets
      // resolved; deleting it would erase that it ever happened.
      allow delete: if false;
    }

    // Append-only. Staff changes are written by the API with the Admin
    // SDK; patient work is written by the browser that performed it,
    // because the dashboard writes patients and health_records directly
    // and the server never sees those.
    //
    // actorUid must equal the caller's own uid, so an entry can only be
    // recorded in the name of whoever wrote it. No update and no delete
    // from anywhere, so nothing here can be revised or erased afterwards
    // - including by the person it describes.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if signedInAndVerified()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Sync logs recording every sync attempt between the mobile app
    // and Firestore.
    // - Web Dashboard (BHN / staff): reads sync logs for BHW monitoring.
    // - BHW: can read, write, and retry sync logs for their account.
    // - Delete is denied to preserve audit trail.
    match /sync_logs/{logId} {
      allow read: if signedInAndVerified()
                  || (isBhw() && resource.data.bhwId == request.auth.uid);
      // A worker files their own sync attempts and nobody else's. The
      // third clause here used to be a bare `request.auth != null`, which
      // let any signed-in account write a log under another worker's id —
      // and this collection is what the RHU's Sync Monitoring page treats
      // as the audit trail of who uploaded what, and when.
      allow create: if signedInAndVerified()
                    || (isBhw() && request.resource.data.bhwId == request.auth.uid);
      allow update: if signedInAndVerified()
                    || (isBhw() && resource.data.bhwId == request.auth.uid);
      allow delete: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
