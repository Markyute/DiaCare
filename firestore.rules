rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A password sign-in alone is NOT enough to read data. The custom
    // claims below are only set by the verifyOtp Cloud Function after the
    // emailed code has been checked, so a user who stops at the password
    // step can still read nothing.
    function signedInAndVerified() {
      return request.auth != null
          && request.auth.token.otpVerified == true
          && request.auth.token.otpAt is number
          // Claims survive across sessions, so freshness is enforced here:
          // a verification older than 12 hours no longer grants access.
          && request.time.toMillis() - request.auth.token.otpAt < 43200000;
    }

    function isAdmin() {
      return signedInAndVerified() && request.auth.token.role == 'admin';
    }

    // Staff accounts. Everyone verified may read the roster (the personnel
    // page needs it); only admins may create, change, or disable accounts,
    // and only through the Cloud Functions, which use the Admin SDK.
    // The roster is an administrator's view. A nurse can read their own
    // profile - the top-nav chip needs their name and role - but not the
    // rest of the staff list, which is the personnel page's data.
    //
    // Hiding the nav link and bouncing the page are conveniences; this is
    // what stops a nurse from simply querying the collection.
    match /users/{uid} {
      allow read: if isAdmin() || (signedInAndVerified() && request.auth.uid == uid);
      allow write: if false;
    }

    // One-time codes. Never readable or writable by a browser — the
    // functions reach these with the Admin SDK, which bypasses rules.
    // Without this the emailed code could simply be read out of Firestore.
    match /otp_codes/{uid} {
      allow read, write: if false;
    }

    // Send-rate counters, same reasoning as otp_codes.
    match /otp_throttle/{uid} {
      allow read, write: if false;
    }

    // Password-reset rate limits. Keyed by a hash of the address rather
    // than the address itself, so the collection is not a readable list
    // of who has asked to reset. Server-only either way.
    match /reset_throttle/{key} {
      allow read, write: if false;
    }

    // Clinical data.
    match /patients/{patientId} {
      allow read: if signedInAndVerified();
      allow create, update: if signedInAndVerified();
      allow delete: if isAdmin();

      match /{sub=**} {
        allow read: if signedInAndVerified();
        allow write: if signedInAndVerified();
      }
    }

    // Visit readings. Written by this dashboard's encoding page and, once
    // the mobile sync lands, pushed by the BHW app. Kept as a top-level
    // collection rather than a subcollection so a sync can ask for
    // everything changed since a timestamp in one query.
    //
    // No delete: a reading is a clinical record. Correcting one means
    // writing a newer record, not erasing the history a risk score was
    // calculated from.
    match /health_records/{recordId} {
      allow read: if signedInAndVerified();
      allow create, update: if signedInAndVerified();
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if signedInAndVerified();
      allow write: if signedInAndVerified();
    }

    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
