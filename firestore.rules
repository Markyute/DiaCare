rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A password sign-in alone is NOT enough to read data. The custom
    // claims below are only set by the verifyOtp Cloud Function after the
    // emailed code has been checked, so a user who stops at the password
    // step can still read nothing.
    function signedInAndVerified() {
      return request.auth != null
          && request.auth.token.otpVerified == true
          && request.auth.token.otpAt is number
          // Claims survive across sessions, so freshness is enforced here:
          // a verification older than 12 hours no longer grants access.
          && request.time.toMillis() - request.auth.token.otpAt < 43200000;
    }

    function isAdmin() {
      return signedInAndVerified() && request.auth.token.role == 'admin';
    }

    // Staff accounts. Everyone verified may read the roster (the personnel
    // page needs it); only admins may create, change, or disable accounts,
    // and only through the Cloud Functions, which use the Admin SDK.
    match /users/{uid} {
      allow read: if signedInAndVerified();
      allow write: if false;
    }

    // One-time codes. Never readable or writable by a browser — the
    // functions reach these with the Admin SDK, which bypasses rules.
    // Without this the emailed code could simply be read out of Firestore.
    match /otp_codes/{uid} {
      allow read, write: if false;
    }

    // Send-rate counters, same reasoning as otp_codes.
    match /otp_throttle/{uid} {
      allow read, write: if false;
    }

    // Clinical data.
    match /patients/{patientId} {
      allow read: if signedInAndVerified();
      allow create, update: if signedInAndVerified();
      allow delete: if isAdmin();

      match /{sub=**} {
        allow read: if signedInAndVerified();
        allow write: if signedInAndVerified();
      }
    }

    match /alerts/{alertId} {
      allow read: if signedInAndVerified();
      allow write: if signedInAndVerified();
    }

    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
